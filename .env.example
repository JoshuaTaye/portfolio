# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Contact form email notifications via SendGrid (optional; messages are also saved to MongoDB when MONGODB_URI is set)
SENDGRID_API_KEY=
# Where contact-form messages are sent
CONTACT_TO_EMAIL=
# A SendGrid-verified sender address
CONTACT_FROM_EMAIL=
